{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "diffs": {
    "wrap": "word",
    "tree": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "prompt": {
    "editor": true
  },
  "tabs": {
    "mode": "off",
    "scope": "cwd"
  }
}
