{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "plan",

    "provider": {
        "FhGenie": {
            "npm": "@ai-sdk/azure",
            "name": "FhGenie",
            "options": {
                "baseURL": "{env:FHGENIE_URL}",
                "apiKey": "{env:FHGENIE_API_KEY}",
            },
            "models": {
                "gpt-5.1-2025-11-13": { "name": "gpt-5.1" },
                "gpt-5-mini-2025-08-07": { "name": "gpt-5-mini" },
                "gpt-5-nano-2025-08-07": { "name": "gpt-5-nano" },
            },
        },
        "FhGenie-on-prem": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "FhGenie on-prem",
            "options": {
                "baseURL": "{env:FHGENIE_ONPREM_URL}",
                "apiKey": "{env:FHGENIE_ONPREM_API_KEY}",
            },
            "models": {
                "Qwen/Qwen3-Coder-Next-FP8": { "name": "Qwen3 Coder Next FP8" },
            },
        },
        "ame-litellm": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "LiteLLM",
            "options": {
                "baseURL": "{env:AME_LITELLM_URL}",
                "apiKey": "{env:AME_LITELLM_API_KEY}",
            },
            "models": {
                "gpt-5.4-nano": { "name": "OpenAI GPT-5.4" },
                "gpt-5.4-mini": { "name": "OpenAI GPT-5.4 Mini" },
                "gpt-5.4-pro": { "name": "OpenAI GPT-5.4 Pro" },
                "gpt-5.4": { "name": "OpenAI GPT-5.4 - EU residency" },
                "gpt-5.3-codex": { "name": "OpenAI GPT-5.3 Codex" },
                "claude-opus-4-7": { "name": "Anthropic Claude Opus 4.7" },
                "claude-opus-4-6": { "name": "Anthropic Claude Opus 4.6" },
                "claude-sonnet-4-6": { "name": "Anthropic Claude Sonnet 4.6" },
                "claude-haiku-4-5": { "name": "Anthropic Claude Haiku 4.5" },
            },
        },
    },
    "model": "github-copilot/gpt-5.3-codex",
    "small_model": "FhGenie/gpt-5-nano-2025-08-07",
}
