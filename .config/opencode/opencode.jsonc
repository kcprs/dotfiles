{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "plan",

    // Models
    "providers": {
        "fhgenie": {
            "package": "aisdk:@ai-sdk/azure",
            "name": "FhGenie",
            "settings": {
                "baseURL": "{env:FHGENIE_URL}",
                "apiKey": "{env:FHGENIE_API_KEY}",
            },
            "models": {
                "gpt-6-luna": { "name": "OpenAI GPT-6 Luna" },
                "gpt-5.6-terra": { "name": "OpenAI GPT-5.6 Terra" },
                "gpt-6.1-sol": { "name": "OpenAI GPT-6.1 Sol" },
                "gpt-6-astra": { "name": "OpenAI GPT-6 Astra" },
            },
        },
        "fhgenie-on-prem": {
            "package": "aisdk:@ai-sdk/openai-compatible",
            "name": "FhGenie on-prem",
            "settings": {
                "baseURL": "{env:FHGENIE_ONPREM_URL}",
                "apiKey": "{env:FHGENIE_ONPREM_API_KEY}",
            },
            "models": {
                "nvidia/GLM-5.3-NVFP4": { "name": "GLM-5.3" },
                "deepseek-ai/DeepSeek-V4.1-Flash": { "name": "DeepSeek V4.1 Flash" },
            },
        },
        "ame-litellm": {
            "package": "aisdk:@ai-sdk/openai-compatible",
            "name": "LiteLLM",
            "settings": {
                "baseURL": "{env:AME_LITELLM_URL}",
                "apiKey": "{env:AME_LITELLM_API_KEY}",
            },
            "models": {
                "gpt-6-luna": { "name": "OpenAI GPT-6 Luna" },
                "gpt-5.6-terra": { "name": "OpenAI GPT-5.6 Terra" },
                "gpt-6.1-sol": { "name": "OpenAI GPT-6.1 Sol" },
                "claude-haiku-5-5": { "name": "Anthropic Claude Haiku 5.5" },
                "claude-sonnet-5-5": { "name": "Anthropic Claude Sonnet 5.5" },
                "claude-opus-5-5": { "name": "Anthropic Claude Opus 5.5" },
                "eu.anthropic.claude-haiku-4-5-20251001-v1:0": { "name": "Anthropic Claude Haiku 4.5 - EU residency" },
                "eu.anthropic.claude-sonnet-5": { "name": "Anthropic Claude Sonnet 5 - EU residency" },
                "eu.anthropic.claude-opus-5": { "name": "Anthropic Claude Opus 5 - EU residency" },
                "DeepSeek-V4.1-Flash": { "name": "DeepSeek V4.1 Flash" },
                "GLM-5.3-NVFP4": { "name": "GLM 5.3 NVFP4" },
                "NVIDIA-Nemotron-3-Nano-4B-BF16": { "name": "NVIDIA Nemotron 3 Nano 4B (BF16)" },
                "Qwen3-Coder-Next-FP8": { "name": "Qwen 3 Coder Next (FP8)" },
            },
        },
    },
    "model": "ame-litellm/GLM-5.3-NVFP4",

