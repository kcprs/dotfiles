default: build

####################################################################################################
#                                             BUILD
####################################################################################################

build:
    cmake -B "${__BUILD_DIR_VAR__:?__BUILD_DIR_VAR__ not defined}"
    cp "${__BUILD_DIR_VAR__:?__BUILD_DIR_VAR__ not defined}/compile_commands.json" .
    cmake --build "${__BUILD_DIR_VAR__:?__BUILD_DIR_VAR__ not defined}"

clean:
    rm -rf -- "${__BUILD_DIR_VAR__:?__BUILD_DIR_VAR__ not defined}"
