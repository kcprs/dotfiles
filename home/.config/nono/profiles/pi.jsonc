{
  "$schema": "./profile.schema.json",
  "extends": "nolabs-ai/pi",
  "meta": {
    "name": "pi",
    "description": "Custom pi profile with additional access to some tools"
  },
  "groups": {
    "include": []
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "~/.npm",
      "~/.local/state/nvim",
      "~/.local/share/nvim"
    ],
    "read": [
      "~/.config/delta/themes",
      "~/.config/nvim"
    ],
    "write": [],
    "allow_file": [
      "~/.config/git/.gitconfig_local"
    ],
    "read_file": [],
    "write_file": [],
    "deny": [
      ".envrc"
    ],
    "suppress_save_prompt": ["/"]
  }
}
