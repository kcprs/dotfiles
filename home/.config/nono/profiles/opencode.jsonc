{
  "$schema": "./profile.schema.json",
  "extends": "nolabs-ai/opencode",
  "meta": {
    "name": "opencode",
    "description": "Custom opencode profile with additional access to some tools"
  },
  "filesystem": {
    "allow": [
      "~/.agents",
      "~/.local/state/nvim",
      "~/.local/share/nvim"
    ],
    "read": [
      "~/.config/delta/themes",
      "~/.config/nvim"
    ],
    "write": [],
    "allow_file": [
      "~/.config/git/.gitconfig_local"
    ],
    "read_file": [
      "~/.pi/agent/AGENTS.md"
    ],
    "write_file": [],
    "deny": [
      ".envrc"
    ],
    "suppress_save_prompt": ["/"]
  },
  "environment": {
    "set_vars": {
      "OPENCODE_CONFIG": "$WORKDIR/.opencode.json"
    }
  }
}
